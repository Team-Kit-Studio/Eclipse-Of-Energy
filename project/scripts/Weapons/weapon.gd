extends Node2D
class_name Weapon
## Базовый класс оружия.
## Сцена оружия сама владеет механикой стрельбы и взаимодействия.
## Один экземпляр меняет свой .tres-ресурс (data) под разные виды оружия.

## Ресурс оружия (.tres, тип ItemData): статистика, текстура, боезапас.
@export var data: ItemData

## Точка вращения (pivot) — общая для всех сцен оружия: вокруг неё ствол/клинок
## поворачивается к курсору. Контроллер оружия работает с ней напрямую.
@onready var pivot: Node2D = $Pivot

## Экипирует оружие (переопределяется в подклассах: применяет текстуру и показывает сцену).
func equip(item_data: ItemData) -> void:
	data = item_data

## Снимает оружие (переопределяется в подклассах).
func unequip() -> void:
	visible = false

## Выполняет атаку оружия (выстрел/удар). Переопределяется в подклассах.
func Atack() -> void:
	pass
