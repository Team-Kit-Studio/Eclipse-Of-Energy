class_name BulletData
extends Resource
## Ресурс пули (по аналогии с ItemData для предметов).
## Одна-единственная сцена пули (bullet_base.tscn) читает этот ресурс —
## не нужно создавать отдельные сцены пуль под каждое оружие.

## Уникальный айди пули (его вводим в оружие, чтобы оно знало, какой снаряд выпускать).
@export var bullet_id: String = ""
## Текстура пули (спрайт снаряда).
@export var texture: Texture2D
## Скорость полёта пули (px/сек).
@export var bullet_speed: float = 200.0
## Урон пули при попадании.
@export var damage: int = 10
## Дальность полёта: пуля исчезает, пролетев это расстояние (0 = бесконечно).
@export var travel_range: float = 300.0
## Особенности: ссылки на эффекты, которые могут быть наложены на врагов
## при попадании. Пока не реализовано — сюда будут подключаться ресурсы эффектов.
@export var effects: Array = []
